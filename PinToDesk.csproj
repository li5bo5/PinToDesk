<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>PinToDesk</AssemblyName>
    <RootNamespace>PinToDesk</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>PTD.ico</ApplicationIcon>
    <Version>2.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <DefineConstants>$(DefineConstants);PTD_DIAG</DefineConstants>
    <Authors>li5bo5</Authors>
    <Company>li5bo5</Company>
    <Product>PinToDesk</Product>
    <Description>Windows 桌面轻量待办事项工具</Description>
    <FileDescription>Windows 桌面轻量待办事项工具</FileDescription>

    <!-- 发布优化选项 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="PTD.ico"/>
  </ItemGroup>

</Project>
